<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.charitymanagement.OperationsController"
            prefWidth="1180" prefHeight="700"
            stylesheets="@../com/mycompany/charitymanagement/style.css">

    <left>
        <VBox spacing="8" styleClass="sidebar">
            <Label text="QUẢN LÝ HOẠT ĐỘNG&#10;TỪ THIỆN" styleClass="sidebar-title"/>
            <Button text="⌂  Trang chủ" onAction="#handleBackHome" styleClass="menu-button"/>
            <Button text="▣  Chiến dịch" onAction="#handleActivities" styleClass="menu-button"/>
            <Button text="♟  Tình nguyện viên" onAction="#handleParticipants" styleClass="menu-button"/>
            <Button text="♥  Nhà tài trợ" onAction="#handleSponsors" styleClass="menu-button"/>
            <Button text="◉  Quyên góp" onAction="#handleDonations" styleClass="menu-button"/>
            <Button text="⚙  Vận hành" onAction="#handleOperations" styleClass="menu-button-active"/>
            <Button text="✎  Nội dung" onAction="#handleContent" styleClass="menu-button"/>
            <Button text="▥  Thống kê - Báo cáo" onAction="#handleReports" styleClass="menu-button"/>
            <Button text="▯  Đăng xuất" onAction="#handleLogout" styleClass="logout-button"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" styleClass="main-content">
            <SplitPane orientation="VERTICAL" dividerPositions="0.5" VBox.vgrow="ALWAYS">
                <VBox spacing="8">
                    <Label text="CHỜ XỬ LÝ: Chờ duyệt / Đang xét / Đang phân công / Chờ xác nhận" styleClass="section-title"/>
                    <TableView fx:id="tablePendingRecords" styleClass="activity-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPendingLoai" text="Loại" prefWidth="110"/>
                            <TableColumn fx:id="colPendingMa" text="Mã" prefWidth="75"/>
                            <TableColumn fx:id="colPendingChienDich" text="Chiến dịch" prefWidth="85"/>
                            <TableColumn fx:id="colPendingDoiTuong" text="Đối tượng" prefWidth="90"/>
                            <TableColumn fx:id="colPendingTieuDe" text="Tiêu đề" prefWidth="175"/>
                            <TableColumn fx:id="colPendingNguoiXuLy" text="Người xử lý" prefWidth="100"/>
                            <TableColumn fx:id="colPendingNgayTao" text="Ngày tạo" prefWidth="90"/>
                            <TableColumn fx:id="colPendingNgayXuLy" text="Ngày xử lý" prefWidth="90"/>
                            <TableColumn fx:id="colPendingTrangThai" text="Trạng thái" prefWidth="105"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="8">
                    <Label text="ĐÃ XỬ LÝ: Đã duyệt / Đã phân công / Có mặt / Xác nhận / Đã xuất" styleClass="section-title"/>
                    <TableView fx:id="tableDoneRecords" styleClass="activity-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colDoneLoai" text="Loại" prefWidth="110"/>
                            <TableColumn fx:id="colDoneMa" text="Mã" prefWidth="75"/>
                            <TableColumn fx:id="colDoneChienDich" text="Chiến dịch" prefWidth="85"/>
                            <TableColumn fx:id="colDoneDoiTuong" text="Đối tượng" prefWidth="90"/>
                            <TableColumn fx:id="colDoneTieuDe" text="Tiêu đề" prefWidth="175"/>
                            <TableColumn fx:id="colDoneNguoiXuLy" text="Người xử lý" prefWidth="100"/>
                            <TableColumn fx:id="colDoneNgayTao" text="Ngày tạo" prefWidth="90"/>
                            <TableColumn fx:id="colDoneNgayXuLy" text="Ngày xử lý" prefWidth="90"/>
                            <TableColumn fx:id="colDoneTrangThai" text="Trạng thái" prefWidth="105"/>
                        </columns>
                    </TableView>
                </VBox>
            </SplitPane>

            <HBox spacing="12" styleClass="action-bar">
                <Button text="Thêm mới" onAction="#handleShowAddForm" styleClass="primary-button"/>
                <Button fx:id="btnSaveRecord" text="Lưu" onAction="#handleSaveRecord" styleClass="quick-button"/>
                <Button text="Xóa" onAction="#handleDeleteRecord" styleClass="danger-button"/>
                <Button fx:id="btnCloseForm" text="Đóng form" onAction="#handleClearForm" styleClass="quick-button"/>
            </HBox>

            <VBox fx:id="formSection" styleClass="form-card operation-form-panel">
                <Label text="THÔNG TIN VẬN HÀNH" styleClass="section-title"/>
                <GridPane hgap="10" vgap="10">
                    <TextField fx:id="txtMaVanHanh" editable="false" promptText="Mã vận hành tự động" styleClass="input-field" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNguoiTao" editable="false" promptText="Người tạo" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNgayTao" editable="false" promptText="Ngày tạo" styleClass="input-field" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNgayXuLy" editable="false" promptText="Ngày xử lý tự động" styleClass="input-field" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <ComboBox fx:id="cboLoaiNghiepVu" promptText="Loại nghiệp vụ" styleClass="input-field" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cboChienDich" promptText="Chiến dịch" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cboDoiTuongLienKet" promptText="Đối tượng liên kết" styleClass="input-field" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cboTrangThai" promptText="Trạng thái" styleClass="input-field" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cboNguoiXuLy" promptText="Người xử lý" styleClass="input-field" GridPane.columnIndex="0" GridPane.rowIndex="2"/>

                    <TextField fx:id="txtTieuDe" promptText="Tiêu đề" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtNoiDung" promptText="Nội dung" styleClass="input-field" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtGhiChu" promptText="Ghi chú" styleClass="input-field" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                </GridPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>
