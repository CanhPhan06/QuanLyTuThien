<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.charitymanagement.SponsorPortalController"
            prefWidth="1180" prefHeight="700"
            stylesheets="@../com/mycompany/charitymanagement/style.css">

    <left>
        <VBox spacing="8" styleClass="sidebar">
            <Label text="NHÀ TÀI TRỢ" styleClass="sidebar-title"/>
            <Button text="⌂  Tổng quan" onAction="#handleOverview" styleClass="menu-button-active"/>
            <Button text="☷  Hồ sơ" onAction="#handleShowProfile" styleClass="menu-button"/>
            <Button text="▣  Chiến dịch" onAction="#handleCampaigns" styleClass="menu-button"/>
            <Button text="▯  Đăng xuất" onAction="#handleLogout" styleClass="logout-button"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="main-content">
        <VBox fx:id="overviewSection" spacing="14">
            <Label text="CỔNG NHÀ TÀI TRỢ" styleClass="page-title"/>
            <Label fx:id="lblWelcome" text="Xin chào" styleClass="section-title"/>

            <HBox spacing="14">
                <VBox styleClass="stat-card">
                    <Label text="Nhà tài trợ" styleClass="muted-text"/>
                    <Label fx:id="lblPartnerId" text="Nhà tài trợ" styleClass="stat-number"/>
                </VBox>
                <VBox styleClass="stat-card">
                    <Label text="Lượt tài trợ" styleClass="muted-text"/>
                    <Label fx:id="lblSupportCount" text="0" styleClass="stat-number green"/>
                </VBox>
                <VBox styleClass="stat-card wide-stat-card">
                    <Label text="Tổng tài trợ bằng tiền" styleClass="muted-text"/>
                    <Label fx:id="lblSupportTotal" text="0 VNĐ" styleClass="stat-number purple"/>
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="campaignPortalBox" spacing="16"/>
                </content>
            </ScrollPane>

            <GridPane hgap="12" vgap="12" styleClass="form-card" visible="false" managed="false">
                <ComboBox fx:id="cboCampaign" promptText="Chọn chiến dịch" styleClass="input-field" maxWidth="Infinity"
                          GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cboSupportType" promptText="Chọn hình thức quyên góp" styleClass="input-field" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <TextField fx:id="txtSupportValue" promptText="Số tiền/giá trị ước tính" styleClass="input-field"
                           GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="txtSupportContent" promptText="Nội dung/ghi chú tài trợ" styleClass="input-field"
                           GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Chiến dịch đang chọn" styleClass="muted-text"/>
                    <Label fx:id="lblSelectedCampaign" text="Chưa chọn chiến dịch" styleClass="dashboard-main-text"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Mục tiêu chiến dịch" styleClass="muted-text"/>
                    <Label fx:id="lblCampaignGoal" text="-" styleClass="dashboard-main-text"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <Label text="Đã ghi nhận" styleClass="muted-text"/>
                    <Label fx:id="lblCampaignProgress" text="-" styleClass="dashboard-main-text"/>
                </VBox>
            </GridPane>

            <HBox spacing="12" styleClass="action-bar" visible="false" managed="false">
                <Button text="Tham gia tài trợ" onAction="#handleJoinCampaign" styleClass="primary-button"/>
                <Button text="Gửi đề xuất tài trợ" onAction="#handleCreateSupport" styleClass="primary-button"/>
                <Button text="Xem chi tiết chiến dịch" onAction="#handleViewCampaignDetail" styleClass="quick-button"/>
                <Button text="Xuất lịch sử" onAction="#handleExportSupport" styleClass="quick-button"/>
                <Button text="Làm mới" onAction="#handleRefresh" styleClass="quick-button"/>
            </HBox>

            <VBox spacing="10" styleClass="comment-panel" visible="false" managed="false">
                <VBox spacing="3">
                    <Label text="Bình luận chiến dịch" styleClass="portal-section-title"/>
                    <Label fx:id="lblSelectedCommentThread" text="Chọn chiến dịch để xem bình luận" styleClass="muted-text"/>
                </VBox>
                <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" prefHeight="200" styleClass="content-scroll comment-scroll">
                    <content>
                        <VBox fx:id="campaignCommentList" spacing="10"/>
                    </content>
                </ScrollPane>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtCampaignComment" promptText="Nhập bình luận cho chiến dịch..." styleClass="input-field comment-input" HBox.hgrow="ALWAYS"/>
                    <Button text="Gửi bình luận" onAction="#handleSendCampaignComment" styleClass="primary-button"/>
                </HBox>
            </VBox>

            <TabPane VBox.vgrow="ALWAYS" visible="false" managed="false">
                <tabs>
                    <Tab text="Chiến dịch cần hỗ trợ" closable="false">
                        <TableView fx:id="tableCampaigns" styleClass="activity-table">
                            <columns>
                                <TableColumn fx:id="colMaChienDich" text="Mã" prefWidth="80"/>
                                <TableColumn fx:id="colTenChienDich" text="Tên chiến dịch" prefWidth="360"/>
                                <TableColumn fx:id="colMucTieu" text="Mục tiêu" prefWidth="160"/>
                                <TableColumn fx:id="colTrangThai" text="Trạng thái" prefWidth="150"/>
                            </columns>
                        </TableView>
                    </Tab>
                    <Tab text="Lịch sử tài trợ của tôi" closable="false">
                        <TableView fx:id="tableSupport" styleClass="activity-table">
                            <columns>
                                <TableColumn fx:id="colMaQuyenGop" text="Mã" prefWidth="90"/>
                                <TableColumn fx:id="colHoatDong" text="Chiến dịch" prefWidth="120"/>
                                <TableColumn fx:id="colNgayQuyenGop" text="Ngày" prefWidth="120"/>
                                <TableColumn fx:id="colHinhThuc" text="Hình thức" prefWidth="150"/>
                                <TableColumn fx:id="colNoiDungQuyenGop" text="Nội dung" prefWidth="360"/>
                                <TableColumn fx:id="colSoTien" text="Giá trị" prefWidth="150"/>
                            </columns>
                        </TableView>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
        <VBox fx:id="profileSection" spacing="14" visible="false" managed="false">
            <Label text="HỒ SƠ NHÀ TÀI TRỢ" styleClass="page-title"/>
            <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="14">
                        <HBox spacing="14">
                            <VBox spacing="8" styleClass="profile-card" HBox.hgrow="ALWAYS">
                                <Label fx:id="lblSponsorProfileName" text="Nhà tài trợ" styleClass="featured-title"/>
                                <Label fx:id="lblSponsorProfileRole" text="Nhà tài trợ" styleClass="content-category"/>
                                <HBox spacing="12">
                                    <VBox styleClass="stat-card report-mini-card">
                                        <Label fx:id="lblSponsorCampaignCount" text="0" styleClass="stat-number"/>
                                        <Label text="Chiến dịch" styleClass="report-card-label"/>
                                    </VBox>
                                    <VBox styleClass="stat-card report-mini-card">
                                        <Label fx:id="lblSponsorDonationCount" text="0" styleClass="stat-number green"/>
                                        <Label text="Lượt đóng góp" styleClass="report-card-label"/>
                                    </VBox>
                                    <VBox styleClass="stat-card report-mini-card">
                                        <Label fx:id="lblSponsorTotalCash" text="0 VNĐ" styleClass="stat-number purple"/>
                                        <Label text="Tổng giá trị" styleClass="report-card-label"/>
                                    </VBox>
                                    <VBox styleClass="stat-card report-mini-card">
                                        <Label fx:id="lblSponsorContributionLevel" text="Mới" styleClass="stat-number orange"/>
                                        <Label text="Mức đóng góp" styleClass="report-card-label"/>
                                    </VBox>
                                </HBox>
                                <VBox spacing="4" styleClass="profile-highlight">
                                    <Label text="Chiến dịch đóng góp nổi bật" styleClass="muted-text"/>
                                    <Label fx:id="lblSponsorTopCampaign" text="-" styleClass="activity-title" wrapText="true"/>
                                </VBox>
                            </VBox>

                            <GridPane hgap="14" vgap="10" styleClass="profile-card" HBox.hgrow="ALWAYS">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="34"/>
                                    <ColumnConstraints percentWidth="66" hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="Mã tổ chức" styleClass="profile-field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Label fx:id="lblSponsorOrgId" text="-" styleClass="profile-field-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Lĩnh vực" styleClass="profile-field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <Label fx:id="lblSponsorOrgField" text="-" styleClass="profile-field-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label text="SĐT" styleClass="profile-field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <Label fx:id="lblSponsorOrgPhone" text="-" styleClass="profile-field-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                <Label text="Email" styleClass="profile-field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <Label fx:id="lblSponsorOrgEmail" text="-" styleClass="profile-field-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                                <Label text="Địa chỉ" styleClass="profile-field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <Label fx:id="lblSponsorOrgAddress" text="-" styleClass="profile-field-value" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                            </GridPane>
                        </HBox>

                        <HBox spacing="14" VBox.vgrow="ALWAYS">
                            <VBox spacing="10" styleClass="profile-card" HBox.hgrow="ALWAYS">
                                <Label text="Lịch sử đồng hành chiến dịch" styleClass="portal-section-title"/>
                                <TableView fx:id="tableSponsorPartnerHistory" styleClass="activity-table" prefHeight="220" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colSponsorPartnerCampaign" text="Chiến dịch" prefWidth="250"/>
                                        <TableColumn fx:id="colSponsorPartnerField" text="Lĩnh vực" prefWidth="130"/>
                                        <TableColumn fx:id="colSponsorPartnerDate" text="Ngày ký" prefWidth="110"/>
                                        <TableColumn fx:id="colSponsorPartnerValue" text="Giá trị" prefWidth="140"/>
                                    </columns>
                                </TableView>
                            </VBox>
                            <VBox spacing="10" styleClass="profile-card" HBox.hgrow="ALWAYS">
                                <Label text="Lịch sử đóng góp" styleClass="portal-section-title"/>
                                <TableView fx:id="tableSponsorContributionHistory" styleClass="activity-table" prefHeight="220" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colSponsorHistoryCampaign" text="Chiến dịch" prefWidth="170"/>
                                        <TableColumn fx:id="colSponsorHistoryDate" text="Ngày" prefWidth="95"/>
                                        <TableColumn fx:id="colSponsorHistoryType" text="Hình thức" prefWidth="110"/>
                                        <TableColumn fx:id="colSponsorHistoryContent" text="Nội dung" prefWidth="240"/>
                                        <TableColumn fx:id="colSponsorHistoryValue" text="Giá trị" prefWidth="120"/>
                                        <TableColumn fx:id="colSponsorHistoryStatus" text="Trạng thái" prefWidth="120"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </HBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
        </StackPane>
    </center>
</BorderPane>
