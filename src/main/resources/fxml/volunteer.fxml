<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.charitymanagement.VolunteerController"
            prefWidth="1180" prefHeight="700"
            stylesheets="@../com/mycompany/charitymanagement/style.css">

    <left>
        <VBox spacing="8" styleClass="sidebar">
            <Label text="TÌNH NGUYỆN VIÊN" styleClass="sidebar-title"/>
            <Button fx:id="btnOverview" text="⌂  Tổng quan" onAction="#handleShowOverview" styleClass="menu-button-active"/>
            <Button fx:id="btnProfile" text="☷  Hồ sơ" onAction="#handleShowProfile" styleClass="menu-button"/>
            <Button fx:id="btnCampaigns" text="▣  Chiến dịch" onAction="#handleShowCampaigns" styleClass="menu-button"/>
            <Button fx:id="btnTasks" text="▤  Công việc" onAction="#handleShowTasks" styleClass="menu-button"/>
            <Button fx:id="btnProof" text="✎  Minh chứng" onAction="#handleShowProof" styleClass="menu-button"/>
            <Button fx:id="btnNotifications" text="◉  Thông báo" onAction="#handleShowNotifications" styleClass="menu-button"/>
            <Button text="▯  Đăng xuất" onAction="#handleLogout" styleClass="logout-button"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="main-content">
            <VBox fx:id="overviewSection" spacing="16">
                <Label text="CỔNG TÌNH NGUYỆN VIÊN" styleClass="page-title"/>
                <Label fx:id="lblWelcome" text="Xin chào" styleClass="section-title"/>

                <HBox spacing="14">
                    <VBox styleClass="stat-card wide-stat-card">
                        <Label text="Chiến dịch hiện tại" styleClass="muted-text"/>
                        <Label fx:id="lblCampaign" text="Chưa tham gia" styleClass="activity-title"/>
                    </VBox>
                    <VBox styleClass="stat-card">
                        <Label text="Trạng thái duyệt" styleClass="muted-text"/>
                        <Label fx:id="lblStatus" text="Chưa đăng ký" styleClass="stat-number green"/>
                    </VBox>
                    <VBox styleClass="stat-card">
                        <Label text="Điểm đánh giá" styleClass="muted-text"/>
                        <Label fx:id="lblScore" text="Chưa có" styleClass="stat-number"/>
                    </VBox>
                    <VBox styleClass="stat-card">
                        <Label text="Thông báo" styleClass="muted-text"/>
                        <Label fx:id="lblNotificationCount" text="0" styleClass="stat-number purple"/>
                    </VBox>
                </HBox>

                <HBox spacing="12" styleClass="action-bar">
                    <Button text="Xem chiến dịch" onAction="#handleShowCampaigns" styleClass="primary-button"/>
                    <Button text="Xem công việc" onAction="#handleShowTasks" styleClass="quick-button"/>
                    <Button text="Gửi minh chứng" onAction="#handleShowProof" styleClass="quick-button"/>
                </HBox>
            </VBox>

            <VBox fx:id="profileSection" spacing="14" visible="false" managed="false">
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="profile-breadcrumb">
                    <Label text="☰" styleClass="profile-breadcrumb-icon"/>
                    <Label text="Trang chủ" styleClass="muted-text"/>
                    <Label text="/" styleClass="muted-text"/>
                    <Label text="Hồ sơ cá nhân" styleClass="profile-field-value"/>
                </HBox>
                <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="14">
                            <HBox spacing="24" alignment="CENTER_LEFT" styleClass="profile-hero-card">
                                <StackPane styleClass="profile-avatar-wrap">
                                    <Label text="TNV" styleClass="profile-avatar"/>
                                    <Label text="⌾" styleClass="profile-camera"/>
                                </StackPane>
                                <VBox spacing="10" HBox.hgrow="ALWAYS">
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <Label fx:id="lblProfileName" text="Tình nguyện viên" styleClass="profile-hero-name"/>
                                        <Label fx:id="lblProfileStatus" text="Đang hoạt động" styleClass="profile-status-chip"/>
                                    </HBox>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <Label text="▣" styleClass="profile-line-icon"/>
                                        <Label fx:id="lblProfileAccountId" text="-" styleClass="profile-field-value"/>
                                        <Label text="•" styleClass="muted-text"/>
                                        <Label fx:id="lblProfileRole" text="Tình nguyện viên" styleClass="profile-field-value"/>
                                    </HBox>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <Label text="▤" styleClass="profile-line-icon"/>
                                        <Label fx:id="lblProfileDepartment" text="-" styleClass="dashboard-main-text"/>
                                    </HBox>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <Label text="⌂" styleClass="profile-line-icon"/>
                                        <Label fx:id="lblProfileSchool" text="-" styleClass="dashboard-main-text"/>
                                    </HBox>
                                </VBox>
                                <VBox spacing="12" alignment="CENTER_RIGHT">
                                    <Button text="✎  Chỉnh sửa hồ sơ" onAction="#handleEditProfile" styleClass="profile-outline-button"/>
                                    <Button text="▣  Đổi mật khẩu" styleClass="quick-button"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="12" styleClass="profile-info-card">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="♙" styleClass="profile-section-icon"/>
                                    <Label text="Thông tin cá nhân" styleClass="portal-section-title"/>
                                </HBox>
                                <VBox spacing="0" styleClass="profile-info-table">
                                    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="profile-info-row">
                                        <Label text="▣" styleClass="profile-info-icon"/>
                                        <Label text="Mã hồ sơ" styleClass="profile-info-label"/>
                                        <Label fx:id="lblProfileId" text="-" styleClass="profile-info-value"/>
                                    </HBox>
                                    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="profile-info-row">
                                        <Label text="☎" styleClass="profile-info-icon"/>
                                        <Label text="Số điện thoại" styleClass="profile-info-label"/>
                                        <Label fx:id="lblProfilePhone" text="-" styleClass="profile-info-value"/>
                                    </HBox>
                                    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="profile-info-row">
                                        <Label text="✉" styleClass="profile-info-icon"/>
                                        <Label text="MSSV/Email" styleClass="profile-info-label"/>
                                        <Label fx:id="lblProfileEmail" text="-" styleClass="profile-info-value"/>
                                    </HBox>
                                    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="profile-info-row">
                                        <Label text="⌂" styleClass="profile-info-icon"/>
                                        <Label text="Chiến dịch hiện tại" styleClass="profile-info-label"/>
                                        <Label fx:id="lblProfileCurrentCampaign" text="-" styleClass="profile-info-value" wrapText="true"/>
                                    </HBox>
                                </VBox>
                            </VBox>

                            <HBox spacing="12">
                                <VBox styleClass="stat-card report-mini-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="lblProfileCampaignCount" text="0" styleClass="stat-number"/>
                                    <Label text="Chiến dịch" styleClass="report-card-label"/>
                                </VBox>
                                <VBox styleClass="stat-card report-mini-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="lblProfileCheckInCount" text="0" styleClass="stat-number green"/>
                                    <Label text="Lượt có mặt" styleClass="report-card-label"/>
                                </VBox>
                                <VBox styleClass="stat-card report-mini-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="lblProfileScore" text="Chưa có" styleClass="stat-number purple"/>
                                    <Label text="Điểm TB" styleClass="report-card-label"/>
                                </VBox>
                                <VBox styleClass="stat-card report-mini-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="lblProfileContributionLevel" text="Mới" styleClass="stat-number orange"/>
                                    <Label text="Mức đóng góp" styleClass="report-card-label"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="14" VBox.vgrow="ALWAYS">
                                <VBox spacing="10" styleClass="profile-card" HBox.hgrow="ALWAYS">
                                    <Label text="Lịch sử tham gia chiến dịch" styleClass="portal-section-title"/>
                                    <TableView fx:id="tableParticipationHistory" styleClass="activity-table" prefHeight="220" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colProfileCampaign" text="Chiến dịch" prefWidth="260"/>
                                            <TableColumn fx:id="colProfileStatus" text="Trạng thái" prefWidth="120"/>
                                            <TableColumn fx:id="colProfileScoreColumn" text="Điểm" prefWidth="80"/>
                                            <TableColumn fx:id="colProfileSchool" text="Trường" prefWidth="130"/>
                                        </columns>
                                    </TableView>
                                </VBox>
                                <VBox spacing="10" styleClass="profile-card" HBox.hgrow="ALWAYS">
                                    <Label text="Lịch sử đóng góp và vận hành" styleClass="portal-section-title"/>
                                    <TableView fx:id="tableProfileHistory" styleClass="activity-table" prefHeight="220" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colProfileHistoryType" text="Nhóm" prefWidth="120"/>
                                            <TableColumn fx:id="colProfileHistoryCampaign" text="Chiến dịch" prefWidth="180"/>
                                            <TableColumn fx:id="colProfileHistoryTitle" text="Nội dung" prefWidth="240"/>
                                            <TableColumn fx:id="colProfileHistoryDate" text="Ngày" prefWidth="95"/>
                                            <TableColumn fx:id="colProfileHistoryStatus" text="Trạng thái" prefWidth="120"/>
                                        </columns>
                                    </TableView>
                                </VBox>
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>

            <VBox fx:id="campaignsSection" spacing="14" visible="false" managed="false">
                <Label text="CHIẾN DỊCH" styleClass="page-title"/>
                <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="campaignPortalBox" spacing="16"/>
                    </content>
                </ScrollPane>
                <GridPane hgap="12" vgap="12" styleClass="form-card" visible="false" managed="false">
                    <ComboBox fx:id="cboCampaign" promptText="Chọn chiến dịch" styleClass="input-field" maxWidth="Infinity"
                              GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Chiến dịch đang chọn" styleClass="muted-text"/>
                        <Label fx:id="lblSelectedCampaign" text="Chưa chọn chiến dịch" styleClass="dashboard-main-text"/>
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Thời gian" styleClass="muted-text"/>
                        <Label fx:id="lblSelectedTime" text="-" styleClass="dashboard-main-text"/>
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <Label text="Địa điểm" styleClass="muted-text"/>
                        <Label fx:id="lblSelectedPlace" text="-" styleClass="dashboard-main-text"/>
                    </VBox>
                </GridPane>
                <HBox spacing="12" styleClass="action-bar" visible="false" managed="false">
                    <Button text="Tham gia chiến dịch" onAction="#handleRegisterCampaign" styleClass="primary-button"/>
                    <Button text="Xem chi tiết chiến dịch" onAction="#handleViewCampaignDetail" styleClass="quick-button"/>
                    <Button text="Làm mới" onAction="#handleRefresh" styleClass="quick-button"/>
                </HBox>
                <VBox spacing="10" styleClass="comment-panel" visible="false" managed="false">
                    <VBox spacing="3">
                        <Label text="Bình luận chiến dịch" styleClass="portal-section-title"/>
                        <Label fx:id="lblSelectedCommentThread" text="Chọn chiến dịch để xem bình luận" styleClass="muted-text"/>
                    </VBox>
                    <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" prefHeight="220" styleClass="content-scroll comment-scroll">
                        <content>
                            <VBox fx:id="campaignCommentList" spacing="10"/>
                        </content>
                    </ScrollPane>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="txtCampaignComment" promptText="Nhập bình luận cho chiến dịch..." styleClass="input-field comment-input" HBox.hgrow="ALWAYS"/>
                        <Button text="Gửi bình luận" onAction="#handleSendCampaignComment" styleClass="primary-button"/>
                    </HBox>
                </VBox>
                <TableView fx:id="tableCampaigns" styleClass="activity-table" VBox.vgrow="ALWAYS" visible="false" managed="false">
                    <columns>
                        <TableColumn fx:id="colMaChienDich" text="Mã" prefWidth="90"/>
                        <TableColumn fx:id="colTenChienDich" text="Tên chiến dịch" prefWidth="360"/>
                        <TableColumn fx:id="colNgayBatDau" text="Bắt đầu" prefWidth="130"/>
                        <TableColumn fx:id="colNgayKetThuc" text="Kết thúc" prefWidth="130"/>
                        <TableColumn fx:id="colTrangThai" text="Trạng thái" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="tasksSection" spacing="14" visible="false" managed="false">
                <Label text="CÔNG VIỆC CỦA TÔI" styleClass="page-title"/>
                <HBox spacing="12" styleClass="action-bar">
                    <Button text="Điểm danh" onAction="#handleCheckIn" styleClass="primary-button"/>
                    <Button text="Gửi minh chứng" onAction="#handleShowProof" styleClass="quick-button"/>
                    <Button text="Làm mới" onAction="#handleRefresh" styleClass="quick-button"/>
                </HBox>
                <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="taskBoard" spacing="12"/>
                    </content>
                </ScrollPane>
                <TableView fx:id="tableTasks" styleClass="activity-table" VBox.vgrow="ALWAYS" visible="false" managed="false">
                    <columns>
                        <TableColumn fx:id="colTaskType" text="Nhóm" prefWidth="150"/>
                        <TableColumn fx:id="colTaskTitle" text="Nội dung" prefWidth="420"/>
                        <TableColumn fx:id="colTaskDate" text="Ngày" prefWidth="120"/>
                        <TableColumn fx:id="colTaskStatus" text="Trạng thái" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="proofSection" spacing="14" visible="false" managed="false">
                <Label text="MINH CHỨNG TÌNH NGUYỆN VIÊN" styleClass="page-title"/>
                <VBox spacing="12" styleClass="proof-panel">
                    <Label text="Gửi minh chứng theo chiến dịch" styleClass="portal-section-title"/>
                    <GridPane hgap="12" vgap="12">
                        <ComboBox fx:id="cboProofCampaign" promptText="Chọn chiến dịch đã tham gia" styleClass="input-field" maxWidth="Infinity"
                              GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="cboProofType" promptText="Chọn loại minh chứng" styleClass="input-field" maxWidth="Infinity"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtProofNote" promptText="Nội dung/ghi chú minh chứng" styleClass="input-field"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtProofImage" promptText="Chưa chọn ảnh minh chứng" styleClass="input-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </GridPane>
                    <Label fx:id="lblProofCampaignStatus" text="Chọn chiến dịch để gửi minh chứng." styleClass="muted-text"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Chọn ảnh" onAction="#handleChooseProofImage" styleClass="quick-button"/>
                        <Button text="Xem ảnh" onAction="#handlePreviewProofImage" styleClass="quick-button"/>
                        <Button text="Bỏ ảnh" onAction="#handleClearProofImage" styleClass="quick-button"/>
                    </HBox>
                </VBox>
                <HBox spacing="12" styleClass="action-bar">
                    <Button text="Gửi minh chứng" onAction="#handleSubmitProof" styleClass="primary-button"/>
                    <Button text="Làm mới" onAction="#handleRefresh" styleClass="quick-button"/>
                </HBox>
            </VBox>

            <VBox fx:id="notificationsSection" spacing="14" visible="false" managed="false">
                <Label text="THÔNG BÁO CỦA TÔI" styleClass="page-title"/>
                <TableView fx:id="tableNotifications" styleClass="activity-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNoticeTitle" text="Tiêu đề" prefWidth="520"/>
                        <TableColumn fx:id="colNoticeDate" text="Ngày" prefWidth="140"/>
                        <TableColumn fx:id="colNoticeStatus" text="Trạng thái" prefWidth="170"/>
                    </columns>
                </TableView>
            </VBox>
            <Button fx:id="btnNotificationBell" text="🔔" onAction="#handleOpenNotificationBell"
                    styleClass="notification-bell-button" StackPane.alignment="TOP_RIGHT"/>
        </StackPane>
    </center>
</BorderPane>
