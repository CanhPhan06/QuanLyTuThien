<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.charitymanagement.ScreeningController"
            prefWidth="1180" prefHeight="700"
            stylesheets="@../com/mycompany/charitymanagement/style.css">
    <center><VBox spacing="14" styleClass="main-content">
        <Label text="TIẾP NHẬN &amp; SƠ TUYỂN HỒ SƠ" styleClass="page-title"/>
        <HBox spacing="12">
            <VBox styleClass="stat-card"><Label text="Tổng hồ sơ" styleClass="muted-text"/><Label fx:id="lblTotalApplicants" text="0" styleClass="stat-number"/></VBox>
            <VBox styleClass="stat-card"><Label text="Chờ xét duyệt" styleClass="muted-text"/><Label fx:id="lblPendingReview" text="0" styleClass="stat-number orange"/></VBox>
            <VBox styleClass="stat-card"><Label text="Đã phỏng vấn" styleClass="muted-text"/><Label fx:id="lblInterviewed" text="0" styleClass="stat-number purple"/></VBox>
            <VBox styleClass="stat-card"><Label text="Đã duyệt" styleClass="muted-text"/><Label fx:id="lblApproved" text="0" styleClass="stat-number green"/></VBox>
        </HBox>
        <HBox spacing="12" styleClass="filter-card">
            <ComboBox fx:id="cboStatusFilter" promptText="Lọc trạng thái" styleClass="input-field" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="cboCampaignFilter" promptText="Lọc chiến dịch" styleClass="input-field" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtSearch" promptText="Tìm họ tên, SĐT, email..." styleClass="input-field wide-search-field" HBox.hgrow="ALWAYS"/>
            <Button text="Bỏ lọc" onAction="#handleClearFilters" styleClass="quick-button"/>
        </HBox>
        <HBox spacing="10" styleClass="action-bar">
            <Button text="Vãng gia" onAction="#handleRecordHomeVisit" styleClass="primary-button"/>
            <Button text="Phỏng vấn" onAction="#handleRecordInterview" styleClass="quick-button"/>
            <Button text="Trình hội đồng" onAction="#handleSubmitToCommittee" styleClass="quick-button"/>
            <Button text="Xét duyệt HĐ" onAction="#handleCommitteeReview" styleClass="primary-button"/>
            <Button text="⇩  Xuất file" onAction="#handleExport" styleClass="quick-button"/>
        </HBox>
        <TableView fx:id="tableApplicants" styleClass="activity-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colHoTen" text="Họ tên" prefWidth="150"/>
                <TableColumn fx:id="colSoDienThoai" text="SĐT" prefWidth="110"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="150"/>
                <TableColumn fx:id="colChienDich" text="Chiến dịch" prefWidth="150"/>
                <TableColumn fx:id="colTrangThai" text="Trạng thái" prefWidth="100"/>
                <TableColumn fx:id="colKetQuaVangGia" text="Vãng gia" prefWidth="100"/>
                <TableColumn fx:id="colNgayPhongVan" text="Ngày PV" prefWidth="100"/>
                <TableColumn fx:id="colKetQuaPhongVan" text="KQ PV" prefWidth="100"/>
                <TableColumn fx:id="colGhiChu" text="Ghi chú" prefWidth="130"/>
            </columns>
        </TableView>
    </VBox></center>
</BorderPane>
