<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.charitymanagement.MainLayoutController"
            prefWidth="1180" prefHeight="700"
            stylesheets="@../../com/mycompany/charitymanagement/style.css">

    <left>
        <VBox spacing="8" styleClass="sidebar">
            <Label fx:id="lblSidebarTitle" text="QUẢN LÝ HOẠT ĐỘNG&#10;TỪ THIỆN" styleClass="sidebar-title"/>
            <Button fx:id="btnHome" text="⌂  Trang chủ" onAction="#handleHome" styleClass="menu-button"/>
            <Button fx:id="btnActivities" text="▣  Chiến dịch" onAction="#handleActivities" styleClass="menu-button"/>
            <Button fx:id="btnParticipants" text="♟  Tình nguyện viên" onAction="#handleParticipants" styleClass="menu-button"/>
            <Button fx:id="btnSponsors" text="♥  Nhà tài trợ" onAction="#handleSponsors" styleClass="menu-button"/>
            <Button fx:id="btnDonations" text="◉  Quyên góp" onAction="#handleDonations" styleClass="menu-button"/>
            <Button fx:id="btnOperations" text="⚙  Vận hành" onAction="#handleOperations" styleClass="menu-button"/>
            <Button fx:id="btnContent" text="✎  Nội dung" onAction="#handleContent" styleClass="menu-button"/>
            <Button fx:id="btnReports" text="▥  Thống kê - Báo cáo" onAction="#handleReports" styleClass="menu-button"/>
            <Button fx:id="btnLogout" text="▯  Đăng xuất" onAction="#handleLogout" styleClass="logout-button"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="main-content"/>
    </center>
</BorderPane>
